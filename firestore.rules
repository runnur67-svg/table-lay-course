rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tablelay_sync/live {
      // Replace FIREBASE_AUTH_USER_UID with the UID of the dedicated shared
      // Firebase Authentication Email/Password account created by the operator.
      allow read, write: if request.auth != null
        && request.auth.uid == 'FIREBASE_AUTH_USER_UID';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
